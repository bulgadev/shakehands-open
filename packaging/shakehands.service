[Unit]
Description=Shakehands input debounce service
After=systemd-udevd.service
Documentation=https://github.com/bulgadev/shakehands-open

[Service]
Type=simple
ExecStart=/usr/local/bin/shakehands daemon --config /etc/shakehands/config.toml
Restart=always
RestartSec=2
User=root
Group=root
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
StateDirectory=shakehands
ReadWritePaths=/dev/input /dev/uinput
# The service still requires root on the currently supported installations.
# Review device permissions and these boundaries before deploying it broadly.
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes

[Install]
WantedBy=multi-user.target
